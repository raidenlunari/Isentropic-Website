---
import { site } from "../data/site";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

// Astro's static build fixes each page's Astro.url.pathname at prerender
// time to the directory-style route it emits (e.g. "/community/"), while
// our link hrefs are written without a trailing slash. Normalize both
// sides to the same shape so the comparison holds in dev and in the
// built/served output alike.
const normalize = (path: string) => (path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path);
const currentPath = normalize(pathname);

const links = [
  { href: "/", label: "Home" },
  { href: "/community", label: "Community" },
  { href: "/research", label: "Research" },
  { href: "/products", label: "Products" },
  { href: "/contribute", label: "Contribute" },
];
---

<nav aria-label="Primary">
  <a class="wordmark" href="/">{site.wordmark} (<span class="phi">{site.phi}</span>)</a>
  <ul class="links">
    {
      links.map((link) => (
        <li>
          <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding: 16px var(--pad-x);
    border-bottom: 1px solid var(--border-soft);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 30px;
    text-decoration: none;
    color: var(--foreground);
    margin-right: auto;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    display: inline-block;
    text-decoration: none;
    color: var(--foreground);
    padding: 2px 0;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition), color var(--transition);
  }

  .links a:hover {
    color: var(--muted-foreground);
    border-bottom-color: var(--border-soft-hover);
  }

  .links a[aria-current="page"] {
    border-bottom-color: var(--foreground);
  }

  @media (max-width: 640px) {
    .wordmark {
      flex: 1 0 100%;
    }

    .links {
      flex: 1 0 100%;
    }
  }
</style>
