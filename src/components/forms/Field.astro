---
interface Props {
  label: string;
  name: string;
  // Namespace for every id this field generates. REQUIRED, and required on
  // purpose: field names are not unique across a page. /contribute renders
  // two forms that both have an `email` and a `message`, and /research
  // renders one manuscript form per entry with the manuscript available.
  // Deriving ids from the field name alone made two controls share
  // id="field-email", which silently moved one form's <label for> onto the
  // other form's input and left the second input with no accessible name
  // at all - a WCAG 1.3.1/4.1.2 failure that axe cannot see (it matches
  // `for` against `id` as a string without checking id uniqueness, and the
  // `duplicate-id-active` rule that would have caught it was removed in
  // axe-core 4.10).
  //
  // Because this prop has no default, `astro check` fails the build at any
  // call site that forgets it, and tests/e2e/forms.spec.ts asserts page-wide
  // id uniqueness and exactly one `element.labels` entry per control on both
  // multi-form pages. Pass the Netlify form name (site.formNames.*), plus
  // the entry slug wherever one form is rendered once per entry.
  idPrefix: string;
  type?: string;
  required?: boolean;
  // Quoted deliberately: an unquoted `as` key here triggers a false-positive
  // `ts(6196) 'Props' is declared but never used` hint from `astro check`
  // (verified in isolation — any Props interface with a property literally
  // named `as` reproduces it, unrelated to whether it's destructured or
  // used). Quoting the key on both this interface and the destructure below
  // avoids the compiler quirk without changing the prop name callers use.
  // Do not "tidy" these quotes away.
  "as"?: "input" | "textarea" | "select";
  options?: string[];
  help?: string;
  maxlength?: number;
}

const {
  label,
  name,
  idPrefix,
  type = "text",
  required = false,
  "as": fieldAs = "input",
  options,
  help,
  maxlength,
} = Astro.props;

const fieldId = `field-${idPrefix}-${name}`;
const helpId = help ? `${idPrefix}-${name}-help` : undefined;
const errorId = `${idPrefix}-${name}-error`;
const describedBy = [helpId, errorId].filter(Boolean).join(" ");
---

<div class="field">
  <label for={fieldId}>{label}</label>

  {
    fieldAs === "textarea" ? (
      <textarea
        id={fieldId}
        name={name}
        required={required}
        maxlength={maxlength}
        aria-describedby={describedBy}
      />
    ) : fieldAs === "select" ? (
      <select id={fieldId} name={name} required={required} aria-describedby={describedBy}>
        <option value="" disabled selected>
          Select one
        </option>
        {options?.map((option: string) => <option value={option}>{option}</option>)}
      </select>
    ) : (
      <input
        id={fieldId}
        name={name}
        type={type as astroHTML.JSX.HTMLInputTypeAttribute}
        required={required}
        maxlength={maxlength}
        aria-describedby={describedBy}
      />
    )
  }

  {help && (
    <p class="help" id={helpId}>
      {help}
    </p>
  )}
  <p class="error" id={errorId}></p>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 20px;
  }

  label {
    font-size: 12px;
    font-weight: 600;
  }

  input,
  textarea,
  select {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    padding: 8px 10px;
    background: var(--card);
    color: var(--foreground);
    border: 1px solid var(--border-soft);
    border-radius: 0;
    transition: border-color var(--transition);
  }

  input:hover,
  textarea:hover,
  select:hover {
    border-color: var(--border-soft-hover);
  }

  textarea {
    min-height: 120px;
    resize: vertical;
  }

  input[type="file"] {
    padding: 8px 0;
    border: none;
  }

  .help {
    margin: 0;
    font-size: 12px;
    color: var(--muted-foreground);
  }

  .error {
    margin: 0;
    font-size: 12px;
    color: var(--foreground);
  }

  .error:empty {
    display: none;
  }
</style>
