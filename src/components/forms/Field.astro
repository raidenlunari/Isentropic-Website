---
interface Props {
  label: string;
  name: string;
  type?: string;
  required?: boolean;
  "as"?: "input" | "textarea" | "select";
  options?: string[];
  help?: string;
  maxlength?: number;
}

const {
  label,
  name,
  type = "text",
  required = false,
  "as": fieldAs = "input",
  options,
  help,
  maxlength,
} = Astro.props;

const fieldId = `field-${name}`;
const helpId = help ? `${name}-help` : undefined;
const errorId = `${name}-error`;
const describedBy = [helpId, errorId].filter(Boolean).join(" ");
---

<div class="field">
  <label for={fieldId}>{label}</label>

  {
    fieldAs === "textarea" ? (
      <textarea
        id={fieldId}
        name={name}
        required={required}
        maxlength={maxlength}
        aria-describedby={describedBy}
      />
    ) : fieldAs === "select" ? (
      <select id={fieldId} name={name} required={required} aria-describedby={describedBy}>
        <option value="" disabled selected>
          Select one
        </option>
        {options?.map((option: string) => <option value={option}>{option}</option>)}
      </select>
    ) : (
      <input
        id={fieldId}
        name={name}
        type={type as astroHTML.JSX.HTMLInputTypeAttribute}
        required={required}
        maxlength={maxlength}
        aria-describedby={describedBy}
      />
    )
  }

  {help && (
    <p class="help" id={helpId}>
      {help}
    </p>
  )}
  <p class="error" id={errorId}></p>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 20px;
  }

  label {
    font-size: 12px;
    font-weight: 600;
  }

  input,
  textarea,
  select {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 20px;
    padding: 8px 10px;
    background: var(--card);
    color: var(--foreground);
    border: 1px solid var(--border-soft);
    border-radius: 0;
    transition: border-color var(--transition);
  }

  input:hover,
  textarea:hover,
  select:hover {
    border-color: var(--border-soft-hover);
  }

  textarea {
    min-height: 120px;
    resize: vertical;
  }

  input[type="file"] {
    padding: 8px 0;
    border: none;
  }

  .help {
    margin: 0;
    font-size: 12px;
    color: var(--muted-foreground);
  }

  .error {
    margin: 0;
    font-size: 12px;
    color: var(--foreground);
  }

  .error:empty {
    display: none;
  }
</style>
