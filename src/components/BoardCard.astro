---
interface Props {
  name: string;
  role: string;
  photo: string;
  alt: string;
}

const { name, role, photo, alt } = Astro.props;
---
<div class="board-card">
  <img
    src={photo}
    alt={alt}
    width="400"
    height="400"
    loading="lazy"
    decoding="async"
  />
  <div class="board-card-body">
    <p class="board-name">{name}</p>
    <p class="board-role">{role}</p>
    <div class="board-bio">
      <slot />
    </div>
  </div>
</div>

<style>
  .board-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--border-soft);
    transition: border-color var(--transition);
  }
  .board-card:hover {
    border-color: var(--border-soft-hover);
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .board-card-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
  }

  .board-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.3;
  }

  .board-role {
    margin: 0;
    font-size: 12px;
    color: var(--muted-foreground);
  }

  .board-bio {
    margin-top: 4px;
    font-size: 12px;
    color: var(--foreground);
  }

  .board-bio :global(p) {
    margin: 0;
  }

  .board-bio :global(p + p) {
    margin-top: 8px;
  }
</style>
