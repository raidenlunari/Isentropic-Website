---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Disclosure from "../components/Disclosure.astro";
import NetlifyForm from "../components/forms/NetlifyForm.astro";
import Field from "../components/forms/Field.astro";
import { openRoles, groupRolesByCategory } from "../lib/posts";
import { site } from "../data/site";

// The open-ended catch-all option applicants use when none of the listed
// roles fit. The literal angle brackets are intentional — Astro escapes
// them automatically wherever this string is interpolated as text, so it
// renders as visible characters rather than being parsed as markup.
const OPEN_ENDED_ROLE = "<insert-role-you-excel-at/>";

// While no role file exists, Astro logs "The collection "roles" does not
// exist or is empty" during the build. That is expected, not an error:
// the collection is declared in content.config.ts and the page handles
// the empty case below. Adding a role file (CONTENT-GUIDE.md Task 8)
// silences it.
const allRoles = await getCollection("roles");
const open = openRoles(allRoles);
const roleGroups = await Promise.all(
  groupRolesByCategory(open).map(async (group) => ({
    category: group.category,
    roles: await Promise.all(
      group.roles.map(async (item) => {
        const { Content } = await render(item);
        return { item, Content };
      }),
    ),
  })),
);
const openRoleTitles = roleGroups.flatMap((group) =>
  group.roles.map(({ item }) => item.data.title),
);
// With no role currently listed, a select whose only entry is the
// open-ended option would be a menu with one choice. The role field is
// then a free-text input instead, under the same field name so the
// Netlify detection stub (public/__forms.html) still matches. Listing a
// role (CONTENT-GUIDE.md Task 8) turns the field back into the select.
const roleOptions = [...openRoleTitles, OPEN_ENDED_ROLE];
const hasListedRoles = openRoleTitles.length > 0;
---

<BaseLayout
  title="Contribute"
  description="How to sponsor Isentropic Robotics by email, or apply to volunteer."
>
  <h1>Contribute</h1>
  <p class="intro">
    Isentropic Robotics is a registered 501(c)(3) nonprofit. It welcomes
    sponsors and volunteers, and both ways of contributing are described
    below.
  </p>

  <h2 class="section-heading">Sponsor</h2>
  <p class="section-intro">
    Sponsorship inquiries are handled by email. Write to <a class="sponsor-email" href={`mailto:${site.email}`}>{site.email}</a> with
    a note on your organization and the support you have in mind, and the
    organization will reply with details.
  </p>

  <h2 class="section-heading">Join us</h2>
  <p class="section-intro">
    Applications are open for volunteers.
    {hasListedRoles
      ? " Open roles are grouped by area below, each with its location and expected time commitment along with its responsibilities and qualifications."
      : " No specific roles are listed at the moment; describe the role or area you would like to help with in the form."}
  </p>

  {hasListedRoles && (
    <div class="role-groups">
      {roleGroups.map(({ category, roles }) => (
        <Disclosure summary={category} meta={`${roles.length} open`}>
          <ul class="role-list">
            {roles.map(({ item, Content }) => (
              <li class="role">
                <h3 class="role-title">{item.data.title}</h3>
                <p class="role-meta">
                  {item.data.location} · {item.data.commitment}
                </p>
                <div class="role-body">
                  <Content />
                </div>
              </li>
            ))}
          </ul>
        </Disclosure>
      ))}
    </div>
  )}

  <h3 class="form-heading">Apply</h3>
  <div class="form-block">
    <NetlifyForm name={site.formNames.application} multipart>
      <Field idPrefix={site.formNames.application} label="Name" name="name" required />
      <Field idPrefix={site.formNames.application} label="Email" name="email" type="email" required />
      {hasListedRoles ? (
        <Field
          idPrefix={site.formNames.application}
          label="Role"
          name="role"
          as="select"
          options={roleOptions}
          required
        />
      ) : (
        <Field
          idPrefix={site.formNames.application}
          label="Role"
          name="role"
          required
          help="The role or area you are applying for."
        />
      )}
      <Field
        idPrefix={site.formNames.application}
        label="Links"
        name="links"
        help="A resume, portfolio, or profile URL, if applicable."
      />
      <Field
        idPrefix={site.formNames.application}
        label="Resume"
        name="resume"
        type="file"
        help="PDF preferred."
      />
      <Field idPrefix={site.formNames.application} label="Message" name="message" as="textarea" required />
    </NetlifyForm>
  </div>
</BaseLayout>

<style>
  .intro,
  .section-intro {
    max-width: var(--measure-prose);
    margin: 0 0 24px;
    font-size: 16px;
    line-height: 24px;
    color: var(--foreground);
  }

  .section-intro {
    font-size: 14px;
    line-height: 20px;
  }

  .section-heading {
    margin: 48px 0 16px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
  }
  .section-heading:first-of-type {
    margin-top: 40px;
  }

  .form-block {
    max-width: var(--measure-prose);
    margin: 0 0 24px;
  }

  .form-heading {
    margin: 32px 0 16px;
    font-size: 16px;
    font-weight: 600;
  }

  .role-groups {
    margin: 0 0 8px;
  }

  .role-list {
    list-style: none;
    margin: 0;
    padding: 0 0 8px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .role {
    padding-top: 4px;
  }

  .role-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }

  .role-meta {
    margin: 4px 0 8px;
    font-size: 12px;
    color: var(--muted-foreground);
  }

  .role-body {
    font-size: 13px;
    line-height: 20px;
    max-width: var(--measure-prose);
  }
  .role-body :global(p) {
    margin: 0 0 8px;
  }
  .role-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .role-body :global(ul) {
    margin: 0 0 8px;
    padding-left: 20px;
  }
</style>
