---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Rail from "../components/Rail.astro";
import RailItem from "../components/RailItem.astro";
import Disclosure from "../components/Disclosure.astro";
import PostCard from "../components/PostCard.astro";
import {
  filterByTopic,
  publishedPosts,
  sortByDateDesc,
  withYearMarkers,
} from "../lib/posts";
import { formatDate } from "../lib/dates";

const allEvents = await getCollection("events");
const eventEntries = withYearMarkers(sortByDateDesc(allEvents));
const events = await Promise.all(
  eventEntries.map(async ({ item, yearMarker }) => {
    const { Content } = await render(item);
    return { item, yearMarker, Content };
  }),
);

const allPosts = await getCollection("blog");
const communityUpdates = withYearMarkers(
  sortByDateDesc(filterByTopic(publishedPosts(allPosts), "community")),
);
---

<BaseLayout
  title="Community"
  description="Isentropic Robotics' community programs: the East Bay Robotics Camp, the Parts Redistribution Program, and updates on both."
>
  <h1>Community</h1>
  <p class="intro">
    Isentropic Robotics runs two community programs. The East Bay Robotics
    Camp teaches competitive robotics fundamentals, robot documentation,
    and robot programming over the summer. The <a href="/parts">Parts Redistribution Program</a> collects
    retired VEX parts from established teams and passes them, with
    mentorship, to schools and programs that need them. The timeline below
    records the organization's events; the updates that follow report on
    the programs.
  </p>
  <h2>Community events</h2>
  <div class="events">
    <Rail>
      {events.map(({ item, yearMarker, Content }) => (
        <RailItem tier="event" yearMarker={yearMarker}>
          <Disclosure
            summary={item.data.title}
            meta={`${formatDate(item.data.date)} · ${item.data.location}`}
          >
            <Content />
          </Disclosure>
        </RailItem>
      ))}
    </Rail>
  </div>

  {communityUpdates.length > 0 && (
    <>
      <h2>Community updates</h2>
      <div class="updates">
        <Rail>
          {communityUpdates.map(({ item, yearMarker }) => (
            <RailItem tier={item.data.tier} yearMarker={yearMarker}>
              <PostCard
                href={`/blog/${item.id}/`}
                title={item.data.title}
                date={item.data.date}
                summary={item.data.summary}
                tier={item.data.tier}
              />
            </RailItem>
          ))}
        </Rail>
      </div>
    </>
  )}
</BaseLayout>

<style>
  .intro {
    max-width: var(--measure-prose);
    margin: 0 0 40px;
    font-size: 16px;
    line-height: 24px;
  }

  h2 {
    margin: 48px 0 16px;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
  }

  .events {
    margin-bottom: 8px;
  }
</style>
